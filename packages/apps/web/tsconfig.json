{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Lets vite.config.ts name the modules it imports with their extension.
    // Vite's native config loader, planned to become the default, requires
    // it, and the current loader warns on every build and test run without it.
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "@testing-library/jest-dom/vitest"],
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "include": ["src", "vite.config.ts", "content-security-policy*.ts"],
  "references": [
    { "path": "../../domain/activity" },
    { "path": "../../gateway/browser" },
    { "path": "../../gateway/session-api" },
    { "path": "../../gateway/activity-api" },
    { "path": "../../testing/api-mocks" }
  ]
}
