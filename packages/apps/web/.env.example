VITE_GITHUB_CLIENT_ID=
VITE_YAGURA_SESSION_API=
# The AppSync Events API's hosts, without a scheme. Optional: unless both are
# set, the page does not update live.
VITE_YAGURA_SIGNAL_HTTP_HOST=
VITE_YAGURA_SIGNAL_REALTIME_HOST=
# Set to 1 to serve the session API and the activity API from in-browser mocks.
VITE_API_MOCK=
# Read by the dev server only: proxies /session and /activity to this URL.
# When set, run
# VITE_YAGURA_SESSION_API=http://localhost:5173 make dev
# (.env.development overrides VITE_YAGURA_SESSION_API in .env.local).
YAGURA_SESSION_API_PROXY=
