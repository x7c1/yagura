VITE_GITHUB_CLIENT_ID=
VITE_YAGURA_SESSION_API=
# Set to 1 to serve the session API and GitHub from in-browser mocks.
VITE_API_MOCK=
# Read by the dev server only: proxies /session to this URL. When set, run
# VITE_YAGURA_SESSION_API=http://localhost:5173 make dev
# (.env.development overrides VITE_YAGURA_SESSION_API in .env.local).
YAGURA_SESSION_API_PROXY=
